{
  "name": "burbuja",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Burbuja: a Sherpas plan explained at your level, in glass bubbles, with voice",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node server/index.mjs\" \"vite\"",
    "server": "node server/index.mjs",
    "build": "vite build",
    "start": "vite build && node server/index.mjs",
    "pregen": "node server/pregen.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "express": "^5.3.0",
    "maath": "^0.10.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "unpdf": "^2.1.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8"
  }
}
